# Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env lên git.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

TOKENS_PATH=models/tokens.txt
ENCODER_PATH=models/encoder.int8.onnx
DECODER_PATH=models/decoder.onnx
JOINER_PATH=models/joiner.int8.onnx
NUM_THREADS=4

# Model VAD (silero-vad) dùng để cắt audio dài thành từng đoạn trước khi
# nhận diện. Tải tại:
# https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx
VAD_MODEL_PATH=models/silero_vad.onnx
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_SEC=0.5
VAD_MIN_SPEECH_SEC=0.25
VAD_MAX_SPEECH_SEC=25
VAD_WINDOW_SIZE=512

TMP_DIR=tmp

# LƯU Ý: Telegram Bot API bản cloud (mặc định) chỉ cho tải file tối đa 20MB
# dù đặt MAX_FILE_SIZE_MB lớn hơn. Muốn nhận file audio dài (vd. 30 phút,
# thường 50-100MB+), phải tự host Local Bot API Server:
# https://github.com/tdlib/telegram-bot-api
MAX_FILE_SIZE_MB=2000
FFMPEG_TIMEOUT_SEC=1800
STT_TIMEOUT_SEC=3600

# ----- LLM (External API) -----
# Bật/tắt LLM chuyển đổi STT text sang cấu trúc JSON.
# Đặt false nếu chỉ muốn text STT thô.
LLM_ENABLED=true
# Đường dẫn API tương thích OpenAI của mô hình LLM (VD: llama-server, vLLM, Oobabooga)
LLM_API_BASE_URL=http://127.0.0.1:8082
# QUAN TRỌNG: Đặt đúng với --ctx-size khi khởi động llama-server.
# Engine dùng giá trị này để tự động cắt input trước khi gửi, tránh lỗi tràn n_token.
# Ví dụ: llama-server --ctx-size 4096 → đặt 4096 ở đây
LLM_CONTEXT_SIZE=4096
# Số token tối đa dành riêng cho phần OUTPUT (JSON response). Không cần sửa.
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SEC=120

