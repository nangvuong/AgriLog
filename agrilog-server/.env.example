# Server Port
PORT=3000

# Allowed frontend origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://washout-diagnosis-dimly.ngrok-free.dev

# Database Configuration (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agrilog_db

# JWT Configuration
JWT_SECRET=agrilog_secret_key_development_only
JWT_EXPIRES_IN=1d

# Supabase Storage Configuration (Activity Media)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=agrilog-media

# AI Service Configuration (FastAPI / Gemini LLM Extraction)
AI_SERVICE_URL=http://localhost:8000
