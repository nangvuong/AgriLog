# ==============================================================================
# POSTGRESQL DATABASE CONFIGURATION (Docker Compose & NestJS Server)
# ==============================================================================

# Server Port
PORT=3000

# JWT Authentication Secret Key
JWT_SECRET=agrilog-secret-key-2026

# Database Connection Info
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agrilog_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Connection String for NestJS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrilog_db?schema=public
