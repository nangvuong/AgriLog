# ==========================================
# CẤU HÌNH AGRI-LOG WEB (FRONTEND VITE)
# ==========================================

# Địa chỉ API chính của Backend Server (NestJS)
# Mặc định khi chạy server ở máy cục bộ:
VITE_API_URL=http://localhost:3000/api

# Tên ứng dụng hiển thị (tuỳ chọn)
VITE_APP_TITLE=AgriLog — Nhật ký Canh tác Thông minh

# OpenWeather API Key — dùng cho chức năng thời tiết thực tế trên form
# Đăng ký miễn phí tại: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Maps API Key — dùng cho MapView, PlotCard, và định vị thửa đất
# Bật APIs: Maps Embed API, Maps Static API, Maps JavaScript API
# Đăng ký tại: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
