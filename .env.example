# ==============================================================================
# AGRILOG — CẤU HÌNH THAM SỐ HỆ THỐNG (.env.example)
# ==============================================================================
# Sao chép file này thành .env cho từng dịch vụ (agrilog-server, agrilog-web,
# agrilog-ai) hoặc dùng làm cấu hình chung cho môi trường Docker Compose.

# ------------------------------------------------------------------------------
# 1. SERVER BACKEND (agrilog-server - NestJS)
# ------------------------------------------------------------------------------
PORT=3000

# Kết nối cơ sở dữ liệu PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agrilog_db

# Cấu hình bảo mật JWT Token
JWT_SECRET=agrilog_secret_key_development_only
JWT_EXPIRES_IN=1d

# Cấu hình Supabase Storage (lưu trữ tệp âm thanh, hình ảnh, video hoạt động)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key
SUPABASE_BUCKET=agrilog-media

# Kết nối sang dịch vụ AI (agrilog-ai)
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT (agrilog-web - Vite / React)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api
VITE_APP_TITLE=AgriLog — Nhật ký Canh tác Thông minh

# ------------------------------------------------------------------------------
# 3. SERVICE AI & TRÍ TUỆ NHÂN TẠO (agrilog-ai - FastAPI / Sherpa-ONNX / Gemini)
# ------------------------------------------------------------------------------
# Cấu hình Bot Telegram & đường dẫn mô hình nhận diện giọng nói (STT - ONNX)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TOKENS_PATH=models/tokens.txt
ENCODER_PATH=models/encoder.int8.onnx
DECODER_PATH=models/decoder.onnx
JOINER_PATH=models/joiner.int8.onnx
NUM_THREADS=4
TMP_DIR=tmp
MAX_FILE_SIZE_MB=20
FFMPEG_TIMEOUT_SEC=120
STT_TIMEOUT_SEC=240

# Cấu hình API Google AI Gemini (LLM trích xuất tự động thông tin từ nhật ký)
LLM_ENABLED=true
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_CONTEXT_SIZE=8192
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SEC=60
